[Unit]
Description=Lansmann Camera 24 hour recording
After=network-online.target mediamtx.service
Requires=mediamtx.service

[Service]
Type=simple
User=camls
Environment=RECORDINGS_DIRECTORY=/mnt/media2/Lænsmann Studio/cam
ExecStartPre=/usr/bin/mkdir -p "/mnt/media2/Lænsmann Studio/cam"
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -rtsp_transport tcp -i rtsp://127.0.0.1:8554/server -map 0:v:0 -map 0:a:0? -c copy -f segment -segment_time 120 -segment_atclocktime 1 -segment_format mp4 -reset_timestamps 1 -strftime 1 "/mnt/media2/Lænsmann Studio/cam/%%d.%%m.%%Y kl %%H:%%M.mp4"
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
